[Unit]
Description=Aethel Rust Memory local JSONL service
After=network.target

[Service]
Type=simple
User=aethel
Group=aethel
WorkingDirectory=/opt/aethel-memory
ExecStart=/opt/aethel-memory/aethel-memory-rust --dimension 384 --capacity 2048 --snapshot /var/lib/aethel-memory/memory.jsonl --socket /run/aethel-memory/memory.sock
Restart=always
RestartSec=3
RuntimeDirectory=aethel-memory
StateDirectory=aethel-memory
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aethel-memory /run/aethel-memory

[Install]
WantedBy=multi-user.target
